# Server
PORT=8000

# CORS: "*" to allow any origin, or a comma-separated allowlist of origins, e.g.
#   CROSS_ORIGIN=http://localhost:5173,https://eternal.example.com
CROSS_ORIGIN=*

# MySQL connection string (used by src/db/index.js)
DB_URI=mysql://user:password@host:3306/database

# JWT
ACCESS_TOKEN_SECRET=replace_with_a_long_random_hex_string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_hex_string
REFRESH_TOKEN_EXPIRY=10d

# Optional: "production" enables secure cookies and hides error stack traces
NODE_ENV=development

# Rate limiting (requests per 15 min window)
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# Email — leave SMTP_HOST empty in dev to log emails to the console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Eternal <no-reply@eternal.local>
# Frontend base URL, used to build links in emails + payment redirects
APP_URL=http://localhost:5173

# Payment gateways — leave blank to run eSewa/Khalti in sandbox (auto-approve on verify)
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=
KHALTI_SECRET_KEY=

# To run the write-path tests against an isolated database, see .env.test.example
# (TEST_DB_URI). Without it `npm test` stays read-only against DB_URI.
