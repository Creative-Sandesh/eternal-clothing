# Copy to .env.test (gitignored) to run the test suite against an isolated
# database instead of the dev one. `src/db/index.js` uses TEST_DB_URI whenever
# it is set and we're in a test context (Vitest, or NODE_ENV=test).
#
# Easiest isolation: create a second database/schema on the same MySQL server
#   CREATE DATABASE eternal_test;
# then point TEST_DB_URI at it and build the schema once:
#   NODE_ENV=test npm run sync && NODE_ENV=test npm run migrate && NODE_ENV=test npm run seed
#
# Without this file the suite still runs read-only against DB_URI, exactly as now.

NODE_ENV=test
TEST_DB_URI=mysql://user:password@host:3306/eternal_test
